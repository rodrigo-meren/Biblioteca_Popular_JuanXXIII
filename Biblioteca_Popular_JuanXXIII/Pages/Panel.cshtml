@page
@model PanelModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary fw-bold">Panel de Control</h1>
    <span class="text-muted"><i class="bi bi-calendar-event"></i> @DateTime.Now.ToString("dd/MM/yyyy")</span>
</div>

<!-- ========================================== -->
<!-- 1. FILA DE TARJETAS DE RESUMEN (TOP 4)     -->
<!-- ========================================== -->
<div class="row g-4 mb-4">
    <!-- Tarjeta Libros -->
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Libros en Catálogo</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalLibros</h2>
                </div>
                <i class="bi bi-book fs-1 opacity-50"></i>
            </div>
            <a asp-page="/Libros/Inicio" class="card-footer text-white text-decoration-none d-flex justify-content-between">
                <small>Ver catálogo</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Socies -->
    <div class="col-md-3">
        <div class="card bg-success text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Socies Activos</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalSocios</h2>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
            <a asp-page="/Socies/Inicio" class="card-footer text-white text-decoration-none d-flex justify-content-between">
                <small>Gestionar socies</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Préstamos -->
    <div class="col-md-3">
        <div class="card bg-warning text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Préstamos Activos</h6>
                    <h2 class="mb-0 fw-bold">@Model.PrestamosActivos</h2>
                </div>
                <i class="bi bi-arrow-left-right fs-1 opacity-50"></i>
            </div>
            <a asp-page="/Prestamos/Inicio" class="card-footer text-dark text-decoration-none d-flex justify-content-between">
                <small>Ver préstamos</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Cuotas -->
    <div class="col-md-3">
        <div class="card bg-danger text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Cuotas Pendientes</h6>
                    <h2 class="mb-0 fw-bold">@Model.CuotasPendientes</h2>
                </div>
                <i class="bi bi-cash-coin fs-1 opacity-50"></i>
            </div>
            <a asp-page="/Cuotas/Inicio" class="card-footer text-white text-decoration-none d-flex justify-content-between">
                <small>Gestionar cobranzas</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>
</div> <!-- ACÁ CERRAMOS LA PRIMERA FILA -->
<!-- ========================================== -->
<!-- 2. FILA DE SECCIONES SECUNDARIAS           -->
<!-- ========================================== -->
<div class="row g-4">

    <!-- COLUMNA IZQUIERDA (Ocupa 8 espacios) -->
    <div class="col-md-8">

        <!-- Tarjeta A: Últimos Préstamos Registrados -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-activity"></i> Últimos Préstamos Registrados
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Libro</th>
                                <th>Socie</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UltimosPrestamos != null && Model.UltimosPrestamos.Any())
                            {
                                foreach (var prestamo in Model.UltimosPrestamos)
                                {
                                    <tr>
                                        <td><strong>@prestamo.Libro.Titulo</strong></td>
                                        <td>@prestamo.Socio.Nombre @prestamo.Socio.Apellido</td>
                                        <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <!-- Si tiene fecha de devolución, ya fue devuelto -->
                                            @if (prestamo.FechaDevolucion.HasValue)
                                            {
                                                <span class="badge bg-secondary">Devuelto</span>
                                            }
                                            else
                                            {
                                               
                                                @if (prestamo.FechaVencimiento < DateTime.Now.Date)
                                                {
                                                    <span class="badge bg-danger">Vencido</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Vigente</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        Todavía no hay préstamos registrados en el sistema.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white text-end">
                <a asp-page="/Prestamos/Inicio" class="btn btn-sm btn-outline-primary">Ver todos los préstamos</a>
            </div>
        </div> <!-- ACÁ CERRAMOS LA TARJETA DE PRÉSTAMOS -->
        <!-- Tarjeta B: Reservas Activas -->
        <!-- Tarjeta B: Reservas Activas -->
        <div class="card shadow-sm border-0 mb-4 border-start border-warning border-4">
            <div class="card-header bg-white border-bottom pb-2 pt-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-bookmark-star-fill text-warning me-2"></i> Reservas Activas
                </h5>
                <span class="badge bg-warning text-dark rounded-pill">@Model.ReservasActivas.Count() en cola</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha Solicitud</th>
                                <th>Socio</th>
                                <th>Libro (Inventario)</th>
                                <th>Estado</th>
                                <th>Vence / Límite</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ReservasActivas != null && Model.ReservasActivas.Any())
                            {
                                @foreach (var reserva in Model.ReservasActivas)
                                {
                                    <tr>
                                        <td>@reserva.FechaSolicitud.ToString("dd/MM/yyyy HH:mm") hs</td>
                                        <td class="fw-bold">@reserva.Socio.Nombre @reserva.Socio.Apellido</td>
                                        <td>
                                            <span class="text-primary fw-bold">#@reserva.Libro.CodigoInventario</span> - @reserva.Libro.Titulo
                                        </td>
                                        <td>
                                            @if (reserva.Estado == "Pendiente de retiro")
                                            {
                                                <span class="badge bg-primary"><i class="bi bi-box-seam me-1"></i> Para Retirar</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="bi bi-hourglass-split me-1"></i> En Espera</span>
                                            }
                                        </td>
                                        <td>
                                            @if (reserva.FechaLimiteRetiro.HasValue)
                                            {
                                                <span class="@(reserva.FechaLimiteRetiro < DateTime.Now ? "text-danger fw-bold" : "text-muted")">
                                                    @reserva.FechaLimiteRetiro.Value.ToString("dd/MM/yyyy HH:mm") hs
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Sin fecha límite</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <!-- RUTA CORREGIDA: Apunta a /Prestamos/Alta -->
                                            <a asp-page="/Prestamos/Alta"
                                               asp-route-libroId="@reserva.LibroId"
                                               asp-route-socioId="@reserva.SocioId"
                                               asp-route-reservaId="@reserva.Id"
                                               class="btn btn-sm btn-success fw-bold shadow-sm"
                                               title="Entregar reserva y convertir en préstamo">
                                                <i class="bi bi-box-seam me-1"></i> Entregar
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="bi bi-emoji-smile fs-4 d-block mb-2 text-secondary"></i>
                                        No hay reservas activas en este momento.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div> <!-- ACÁ CERRAMOS LA TARJETA DE RESERVAS -->

    </div> <!-- ACÁ CERRAMOS LA COLUMNA IZQUIERDA (col-md-8) -->
    <!-- COLUMNA DERECHA (Ocupa 4 espacios) -->
    <div class="col-md-4">

        <!-- Tarjeta C: Recordatorios -->
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold text-danger">
                <i class="bi bi-pin-angle"></i> Recordatorios
            </div>
            <div class="card-body d-flex flex-column">

                <!-- Lista de notas -->
                <ul class="list-group list-group-flush mb-3" style="max-height: 250px; overflow-y: auto;">
                    @if (Model.NotasPendientes != null && Model.NotasPendientes.Any())
                    {
                        foreach (var nota in Model.NotasPendientes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start px-0">

                                <!-- Botón para tachar (Resolver) -->
                                <form method="post" asp-page-handler="ResolverNota" class="me-2 m-0">
                                    <input type="hidden" name="id" value="@nota.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-success p-0 border-0" title="Marcar como resuelto">
                                        <i class="bi bi-circle"></i>
                                    </button>
                                </form>

                                <!-- Texto de la nota -->
                                <div class="ms-1 me-auto small">
                                    @nota.Texto
                                </div>

                                <!-- Etiqueta Urgente (si aplica) -->
                                @if (nota.EsUrgente)
                                {
                                    <span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.65rem;">Urgente</span>
                                }
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item px-0 text-center text-muted small border-0 mt-3">
                            <i class="bi bi-check2-all fs-4 d-block"></i>
                            Todo al día. No hay notas pendientes.
                        </li>
                    }
                </ul>

                <!-- Formulario para agregar nota rápida -->
                <div class="mt-auto pt-3 border-top">
                    <form method="post" asp-page-handler="CrearNota">
                        <div class="input-group">
                            <input type="text" name="textoNota" class="form-control form-control-sm" placeholder="Escribir un recordatorio..." required autocomplete="off">
                            <button class="btn btn-sm btn-danger" type="submit"><i class="bi bi-plus-lg"></i></button>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input form-check-input-sm" type="checkbox" name="esUrgente" value="true" id="checkUrgente">
                            <label class="form-check-label small text-muted" for="checkUrgente">
                                Es urgente
                            </label>
                        </div>
                    </form>
                </div>

            </div>
        </div> <!-- ACÁ CERRAMOS LA TARJETA DE RECORDATORIOS -->

    </div> <!-- ACÁ CERRAMOS LA COLUMNA DERECHA (col-md-4) -->
    <!-- ========================================== -->
    <!-- 3. SECCIÓN DE MODERACIÓN DE RESEÑAS        -->
    <!-- ========================================== -->
    <div class="row mt-4 mb-5">
        <div class="col-12">
            <div class="card shadow-sm border-0 border-top border-info border-4">
                <div class="card-header bg-white pb-2 pt-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-chat-text text-info me-2"></i> Moderación de Reseñas Recientes
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Socie</th>
                                    <th>Libro</th>
                                    <th>Comentario</th>
                                    <th>Calificación</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.UltimasResenas != null && Model.UltimasResenas.Any())
                                {
                                    foreach (var resena in Model.UltimasResenas)
                                    {
                                        <!-- Si la reseña está oculta, pintamos todo el renglón de gris -->
                                        <tr class="@(!resena.Aprobada ? "table-secondary text-muted" : "")">
                                            <td>@resena.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="fw-bold">@resena.Socio.Nombre @resena.Socio.Apellido</td>
                                            <td><span class="text-primary fw-bold">#@resena.Libro.CodigoInventario</span></td>

                                            <!-- Esto corta los textos muy largos y pone "..." al final -->
                                            <td style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@resena.Comentario">
                                                @(string.IsNullOrEmpty(resena.Comentario) ? "(Solo dejó estrellas)" : resena.Comentario)
                                            </td>

                                            <td class="text-warning">
                                                @for (int i = 0; i < resena.Calificacion; i++)
                                                {
                                                    <span>★</span>
                                                }
                                            </td>
                                            <td>
                                                @if (resena.Aprobada)
                                                {
                                                    <span class="badge bg-success">Visible</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Oculta</span>
                                                }
                                            </td>
                                            <td>
                                                <form method="post" asp-page-handler="ModerarResena" class="m-0">
                                                    <input type="hidden" name="id" value="@resena.Id" />
                                                    <button type="submit" class="btn btn-sm @(resena.Aprobada ? "btn-outline-danger" : "btn-outline-success")">
                                                        @if (resena.Aprobada)
                                                        {
                                                            <i class="bi bi-eye-slash"></i> <span>Ocultar</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-eye"></i> <span>Mostrar</span>
                                                        }
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="bi bi-chat-square text-secondary fs-3 d-block mb-2"></i>
                                            Todavía no hay reseñas en la plataforma.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- ACÁ CERRAMOS LA SEGUNDA FILA -->