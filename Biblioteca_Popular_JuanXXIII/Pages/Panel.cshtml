@page
@model PanelModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary fw-bold">Panel de Control</h1>
    <span class="text-muted"><i class="bi bi-calendar-event"></i> @DateTime.Now.ToString("dd/MM/yyyy")</span>
</div>

<!-- FILA DE TARJETAS DE RESUMEN -->
<div class="row g-4 mb-4">
    <!-- Tarjeta Libros -->
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Libros en Catálogo</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalLibros</h2>
                </div>
                <i class="bi bi-book fs-1 opacity-50"></i>
            </div>
            <a asp-page="/Libros/Inicio" class="card-footer text-white text-decoration-none d-flex justify-content-between">
                <small>Ver catálogo</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Socies -->
    <div class="col-md-3">
        <div class="card bg-success text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Socies Activos</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalSocios</h2>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
            <a asp-page="/Socies/Inicio" class="card-footer text-white text-decoration-none d-flex justify-content-between">
                <small>Gestionar socies</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Préstamos -->
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Préstamos Activos</h6>
                    <h2 class="mb-0 fw-bold">@Model.PrestamosActivos</h2>
                </div>
                <i class="bi bi-arrow-left-right fs-1 opacity-50"></i>
            </div>
            <!-- Acá cambiamos el div por un enlace real (etiqueta a) -->
            <a asp-page="/Prestamos/Inicio" class="card-footer text-dark text-decoration-none d-flex justify-content-between">
                <small>Ver préstamos</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Cuotas -->
    <div class="col-md-3">
        <div class="card bg-danger text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-uppercase mb-1">Cuotas Pendientes</h6>
                    <h2 class="mb-0 fw-bold">@Model.CuotasPendientes</h2>
                </div>
                <i class="bi bi-cash-coin fs-1 opacity-50"></i>
            </div>
            <a asp-page="/Cuotas/Inicio" class="card-footer text-white text-decoration-none d-flex justify-content-between">
                <small>Gestionar cobranzas</small> <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

<!-- FILA DE SECCIONES SECUNDARIAS -->
<div class="row g-4">
   <!-- Accesos Rápidos y Últimos Movimientos -->
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-activity"></i> Últimos Préstamos Registrados
            </div>
            <!-- p-0 saca el padding para que la tabla pegue bien a los bordes -->
            <div class="card-body p-0"> 
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Libro</th>
                                <th>Socie</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UltimosPrestamos != null && Model.UltimosPrestamos.Any())
                            {
                                foreach (var prestamo in Model.UltimosPrestamos)
                                {
                                    <tr>
                                        <td><strong>@prestamo.Libro.Titulo</strong></td>
                                        <td>@prestamo.Socio.Nombre @prestamo.Socio.Apellido</td>
                                        <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (prestamo.Estado == "Vigente")
                                            {
                                                <span class="badge bg-success">Vigente</span>
                                            }
                                            else if (prestamo.Estado == "Vencido")
                                            {
                                                <span class="badge bg-danger">Vencido</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Devuelto</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        Todavía no hay préstamos registrados en el sistema.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white text-end">
                <a asp-page="/Prestamos/Inicio" class="btn btn-sm btn-outline-primary">Ver todos los préstamos</a>
            </div>
        </div>
    </div>

    <!-- Recordatorios / Notas -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold text-danger">
                <i class="bi bi-pin-angle"></i> Recordatorios
            </div>
           <div class="card-body d-flex flex-column">
                
                <!-- Lista de notas -->
                <ul class="list-group list-group-flush mb-3" style="max-height: 250px; overflow-y: auto;">
                    @if (Model.NotasPendientes != null && Model.NotasPendientes.Any())
                    {
                        foreach (var nota in Model.NotasPendientes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start px-0">
                                
                                <!-- Botón para tachar (Resolver) -->
                                <form method="post" asp-page-handler="ResolverNota" class="me-2 m-0">
                                    <input type="hidden" name="id" value="@nota.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-success p-0 border-0" title="Marcar como resuelto">
                                        <i class="bi bi-circle"></i>
                                    </button>
                                </form>

                                <!-- Texto de la nota -->
                                <div class="ms-1 me-auto small">
                                    @nota.Texto
                                </div>
                                
                                <!-- Etiqueta Urgente (si aplica) -->
                                @if (nota.EsUrgente)
                                {
                                    <span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.65rem;">Urgente</span>
                                }
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item px-0 text-center text-muted small border-0 mt-3">
                            <i class="bi bi-check2-all fs-4 d-block"></i>
                            Todo al día. No hay notas pendientes.
                        </li>
                    }
                </ul>

                <!-- Formulario para agregar nota rápida -->
                <div class="mt-auto pt-3 border-top">
                    <form method="post" asp-page-handler="CrearNota">
                        <div class="input-group">
                            <input type="text" name="textoNota" class="form-control form-control-sm" placeholder="Escribir un recordatorio..." required autocomplete="off">
                            <button class="btn btn-sm btn-danger" type="submit"><i class="bi bi-plus-lg"></i></button>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input form-check-input-sm" type="checkbox" name="esUrgente" value="true" id="checkUrgente">
                            <label class="form-check-label small text-muted" for="checkUrgente">
                                Es urgente
                            </label>
                        </div>
                    </form>
                </div>
                
            </div>
        </div>
    </div>
</div>