@page "/Prestamos"
@model Biblioteca_Popular_JuanXXIII.Pages.Prestamos.InicioModel
@{
    ViewData["Title"] = "Control de Préstamos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-institucional-rojo"><i class="bi bi-journal-arrow-up me-2"></i>Control de Préstamos</h1>
    <a asp-page="Alta" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Préstamo
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Libro</th>
                    <th>Socio</th>
                    <th>Fechas</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Prestamo)
                {
                    // Lógica del Semáforo para Préstamos (Ya no evaluamos Devuelto porque no llegan acá)
                    string claseEstado = "";
                    string textoEstado = item.Estado;

                    var diasRestantes = (item.FechaVencimiento.Date - DateTime.Today).TotalDays;

                    if (diasRestantes < 0)
                    {
                        claseEstado = "bg-danger";
                        textoEstado = $"Vencido (hace {Math.Abs(diasRestantes)} días)";
                    }
                    else if (diasRestantes <= 3)
                    {
                        claseEstado = "bg-warning text-dark";
                        textoEstado = $"Vence pronto (en {diasRestantes} días)";
                    }
                    else
                    {
                        claseEstado = "bg-success";
                        textoEstado = "Vigente";
                    }

                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold text-dark">@item.Libro.Titulo</span><br />
                            <small class="text-muted">@item.Libro.Autor</small>
                        </td>
                        <td>
                            <span class="fw-bold">@item.Socio.Apellido, @item.Socio.Nombre</span>
                            @if (!string.IsNullOrEmpty(item.Socio.Pronombre))
                            {
                                <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.70rem;">@item.Socio.Pronombre</span>
                            }
                        </td>
                        <td>
                            <div class="text-muted" style="font-size: 0.85rem;">
                                <strong>Retiró:</strong> @item.FechaPrestamo.ToString("dd/MM/yy") <br />
                                <strong>Devuelve:</strong> @item.FechaVencimiento.ToString("dd/MM/yy")
                            </div>
                        </td>
                        <td>
                            <span class="badge @claseEstado p-2 shadow-sm">@textoEstado</span>
                            @if (item.CantidadRenovaciones > 0)
                            {
                                <div class="mt-1">
                                    <span class="badge border border-info text-info" style="font-size: 0.70rem;" title="Veces renovado">
                                        <i class="bi bi-arrow-repeat"></i> Ren: @item.CantidadRenovaciones
                                    </span>
                                </div>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-page="./Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Ver ficha completa">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Editar" asp-route-id="@item.Id" class="btn btn-sm btn-secondary" title="Modificar/Renovar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <!-- BOTÓN DE DEVOLUCIÓN RÁPIDA -->
                            <form method="post" asp-page-handler="Devolver" asp-route-id="@item.Id" class="d-inline me-1">
                                <button type="submit" class="btn btn-sm btn-success shadow-sm"
                                        onclick="return confirm('¿Confirmar la devolución de este libro? Quedará disponible en el catálogo automáticamente.');"
                                        title="Registrar Devolución Rápida">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                </button>
                            </form>
                            <!-- Botón de Borrado con advertencia -->
                            <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('¿Estás segure de querer eliminar este registro de préstamo?');" title="Eliminar registro">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Prestamo.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-info-circle me-1"></i> No hay préstamos activos en este momento.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CONTROLES DE PAGINACIÓN -->
@if (Model.TotalPaginas > 1)
{
    int maxPaginasVisibles = 5;
    int paginaInicio = Math.Max(1, Model.PaginaActual - 2);
    int paginaFin = Math.Min(Model.TotalPaginas, paginaInicio + maxPaginasVisibles - 1);

    paginaInicio = Math.Max(1, paginaFin - maxPaginasVisibles + 1);

    <nav aria-label="Navegación de páginas">
        <ul class="pagination justify-content-center mt-4 shadow-sm">

            <!-- Botón Primera -->
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="1">
                    <i class="bi bi-chevron-double-left"></i> Primera
                </a>
            </li>

            <!-- Botón Anterior -->
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="@(Model.PaginaActual - 1)">
                    <i class="bi bi-chevron-left"></i> Anterior
                </a>
            </li>

            <!-- Números de página -->
            @for (int i = paginaInicio; i <= paginaFin; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-route-PaginaActual="@i">@i</a>
                </li>
            }

            <!-- Botón Siguiente -->
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="@(Model.PaginaActual + 1)">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </a>
            </li>

            <!-- Botón Última -->
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="@Model.TotalPaginas">
                    Última <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
    <div class="text-center text-muted small mt-2">
        Página @Model.PaginaActual de @Model.TotalPaginas
    </div>
}