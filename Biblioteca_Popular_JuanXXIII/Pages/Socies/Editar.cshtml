@page
@model Biblioteca_Popular_JuanXXIII.Pages.Socies.EditarModel
@{
    ViewData["Title"] = "Editar Socie";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-institucional-rojo"><i class="bi bi-pencil-square me-2"></i>Editar: @Model.Socio.Nombre @Model.Socio.Apellido</h2>
</div>
<hr />
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm my-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm my-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- SECCIÓN REGENERAR CONTRASEÑA -->
<div class="card border-warning shadow-sm mt-4">
    <div class="card-header bg-warning bg-opacity-10 fw-bold text-dark">
        <i class="bi bi-key-fill text-warning me-2"></i> Gestión de Credenciales
    </div>
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <p class="mb-0 fw-bold">Restablecer acceso al sistema</p>
            <small class="text-muted">Si el socio no puede ingresar, este botón regenerará su contraseña asignándole nuevamente su DNI.</small>
        </div>
        <form method="post" asp-page-handler="RegenerarPassword" asp-route-id="@Model.Socio.Id">
            <button type="submit" class="btn btn-outline-warning text-dark fw-bold" onclick="return confirm('¿Seguro que querés blanquear la contraseña de este socio?');">
                <i class="bi bi-arrow-clockwise me-1"></i> Resetear a DNI
            </button>
        </form>
    </div>
</div>

<form method="post" class="bg-white p-4 rounded shadow-sm">
    <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

    <!-- CAMPOS OCULTOS FUNDAMENTALES PARA NO ROMPER LA BASE DE DATOS -->
    <input type="hidden" asp-for="Socio.Id" />
    <input type="hidden" asp-for="Socio.FechaAlta" />

    <div class="row">
        <!-- Columna Izquierda: Datos Personales -->
        <div class="col-md-6 border-end pe-4">
            <h4 class="text-muted mb-3">Datos Personales</h4>

            <div class="row">
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.Nombre" class="control-label fw-bold">Nombre *</label>
                    <input asp-for="Socio.Nombre" class="form-control" />
                </div>
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.Apellido" class="control-label fw-bold">Apellido *</label>
                    <input asp-for="Socio.Apellido" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.DniCarnet" class="control-label fw-bold">DNI o Carnet *</label>
                    <input asp-for="Socio.DniCarnet" class="form-control" />
                </div>
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.FechaNacimiento" class="control-label fw-bold">Fecha de Nac. *</label>
                    <input asp-for="Socio.FechaNacimiento" type="date" class="form-control" />
                </div>
            </div>

            <div class="row bg-light p-3 rounded mt-2 mb-3 border">
                <div class="col-7 form-group">
                    <label asp-for="Socio.Genero" class="control-label fw-bold">Género</label>
                    <select asp-for="Socio.Genero" class="form-select">
                        <option value="">Seleccionar...</option>
                        <option value="Mujer Cis">Mujer Cis</option>
                        <option value="Varon Cis">Varón Cis</option>
                        <option value="Mujer Trans">Mujer Trans</option>
                        <option value="Varon Trans">Varón Trans</option>
                        <option value="No Binarie">No Binarie</option>
                        <option value="Fluido">Género Fluido</option>
                        <option value="Agénero">Agénero</option>
                        <option value="Otro">Otra identidad</option>
                        <option value="Prefiere no decirlo">Prefiere no decirlo</option>
                    </select>
                </div>
                <div class="col-5 form-group">
                    <label asp-for="Socio.Pronombre" class="control-label fw-bold">Pronombre</label>
                    <select asp-for="Socio.Pronombre" class="form-select">
                        <option value="">Seleccionar...</option>
                        <option value="Ella">Ella</option>
                        <option value="El">Él</option>
                        <option value="Elle">Elle</option>
                        <option value="Cualquiera">Indistinto</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Contacto y Administrativo -->
        <div class="col-md-6 ps-4">
            <h4 class="text-muted mb-3">Contacto y Administrativo</h4>

            <div class="row">
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.Telefono" class="control-label fw-bold">Teléfono</label>
                    <input asp-for="Socio.Telefono" class="form-control" />
                </div>
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.Correo" class="control-label fw-bold">Correo Electrónico</label>
                    <input asp-for="Socio.Correo" type="email" class="form-control" />
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Socio.Direccion" class="control-label fw-bold">Dirección</label>
                <input asp-for="Socio.Direccion" class="form-control" />
            </div>

            <div class="row">
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.Categoria" class="control-label fw-bold">Categoría *</label>
                    <select asp-for="Socio.Categoria" class="form-select">
                        <option value="">Seleccionar...</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Docente">Docente</option>
                        <option value="Adulto">Adulto</option>
                        <option value="Jubilado">Jubilado</option>
                        <option value="Infantil">Infantil</option>
                    </select>
                </div>
                <div class="col-6 form-group mb-3">
                    <label asp-for="Socio.FechaVencimiento" class="control-label fw-bold">Vencimiento cuota</label>
                    <input asp-for="Socio.FechaVencimiento" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-check mt-4 p-3 bg-warning bg-opacity-10 border border-warning rounded">
                <input class="form-check-input ms-1 border-warning" asp-for="Socio.Activo" />
                <label class="form-check-label ms-2 fw-bold text-dark" asp-for="Socio.Activo">
                    ¿Socie Activo/a/e?
                </label>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-3 border-top text-end">
        <a asp-page="./Inicio" class="btn btn-outline-secondary me-2">Cancelar</a>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-2"></i>Guardar Cambios</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}