@page
@model Biblioteca_Popular_JuanXXIII.Pages.Socies.DetallesModel
@{
    ViewData["Title"] = "Detalles de Socie";

    // Replicamos la lógica del semáforo para la cuota
    string claseColorCuota = "bg-secondary";
    string textoCuota = "Sin registrar";

    if (Model.Socio.FechaVencimiento.HasValue)
    {
        var diasVencidos = (DateTime.Today - Model.Socio.FechaVencimiento.Value.Date).TotalDays;

        if (diasVencidos <= 0)
        {
            claseColorCuota = "bg-success";
            textoCuota = "Al día";
        }
        else if (diasVencidos <= 10)
        {
            claseColorCuota = "bg-warning text-dark";
            textoCuota = "Alerta (Vencido hace poco)";
        }
        else
        {
            claseColorCuota = "bg-danger";
            textoCuota = "En Deuda";
        }
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="text-institucional-rojo">Ficha del Socie</h1>
</div>

<div class="card shadow-sm border-0">
    <div class="row g-0">
        <!-- Columna del Perfil (Izquierda) -->
        <div class="col-md-3 bg-light p-4 border-end d-flex flex-column align-items-center justify-content-center text-center">
            <i class="bi bi-person-badge text-secondary" style="font-size: 8rem;"></i>

            <div class="mt-3">
                @if (Model.Socio.Activo)
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Habilitade</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Inhabilitade</span>
                }
            </div>
            <div class="mt-2">
                <span class="badge border border-info text-info fs-6">Categoría: @Model.Socio.Categoria</span>
            </div>
        </div>

        <!-- Columna de la Información (Derecha) -->
        <div class="col-md-9">
            <div class="card-body p-4">

                <h2 class="card-title fw-bold text-dark mb-1">
                    @Model.Socio.Apellido, @Model.Socio.Nombre
                </h2>

                <p class="text-muted mb-4">
                    <i class="bi bi-card-text me-1"></i> DNI/Carnet: <strong class="text-dark">@Model.Socio.DniCarnet</strong>
                    @if (!string.IsNullOrEmpty(Model.Socio.Pronombre))
                    {
                        <span class="badge bg-light text-secondary border ms-2">Pronombre: @Model.Socio.Pronombre</span>
                    }
                </p>

                <div class="row border-top pt-3">
                    <div class="col-md-6">
                        <h5 class="text-institucional-rojo mb-3">Datos de Contacto</h5>

                        <p class="mb-2"><i class="bi bi-telephone text-secondary me-2"></i> @(string.IsNullOrEmpty(Model.Socio.Telefono) ? "No registrado" : Model.Socio.Telefono)</p>
                        <p class="mb-2"><i class="bi bi-envelope text-secondary me-2"></i> @(string.IsNullOrEmpty(Model.Socio.Correo) ? "No registrado" : Model.Socio.Correo)</p>
                        <p class="mb-2"><i class="bi bi-geo-alt text-secondary me-2"></i> @(string.IsNullOrEmpty(Model.Socio.Direccion) ? "No registrada" : Model.Socio.Direccion)</p>
                    </div>

                    <div class="col-md-6 border-start ps-4">
                        <h5 class="text-institucional-rojo mb-3">Información Administrativa</h5>

                        <p class="mb-2">
                            <span class="fw-bold text-secondary">Fecha de Alta:</span>
                            @Model.Socio.FechaAlta.ToString("dd/MM/yyyy")
                        </p>
                        <p class="mb-2">
                            <span class="fw-bold text-secondary">Nacimiento:</span>
                            @Model.Socio.FechaNacimiento.ToString("dd/MM/yyyy")
                        </p>
                        <p class="mb-2">
                            <span class="fw-bold text-secondary">Género:</span>
                            @(string.IsNullOrEmpty(Model.Socio.Genero) ? "No especificado" : Model.Socio.Genero)
                        </p>

                        <div class="mt-3 p-2 bg-light border rounded">
                            <span class="fw-bold text-secondary me-2">Estado de Cuota:</span>
                            <span class="badge @claseColorCuota fs-6">@textoCuota</span>
                            @if (Model.Socio.FechaVencimiento.HasValue)
                            {
                                <div class="text-muted mt-1" style="font-size: 0.85rem;">
                                    Vencimiento: @Model.Socio.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                </div>
                            }
                        </div>

                    </div>
                </div>
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-white fw-bold text-danger d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-cash-coin"></i> Estado de Cuotas</span>

                        <!-- Botón temporal para agregar una cuota manual a futuro -->
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-plus"></i> Adelantar Mes</button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mes</th>
                                    <th>Vencimiento</th>
                                    <th>Monto</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Cuotas != null && Model.Cuotas.Any())
                                {
                                    foreach (var cuota in Model.Cuotas)
                                    {
                                        <tr>
                                            <td class="text-capitalize">@cuota.MesCorrespondiente</td>
                                            <td>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                            <td>$@cuota.Monto.ToString("0.00")</td>
                                            <td>
                                                @if (cuota.Estado == "Pagada")
                                                {
                                                    <span class="badge bg-success">Pagada el @cuota.FechaPago?.ToString("dd/MM")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@cuota.Estado</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (cuota.Estado != "Pagada")
                                                {
                                                    <form method="post" asp-page-handler="RegistrarPago" class="m-0">
                                                        <input type="hidden" name="cuotaId" value="@cuota.Id" />
                                                        <input type="hidden" name="socioId" value="@Model.Socio.Id" />
                                                        <button type="submit" class="btn btn-sm btn-success shadow-sm" onclick="return confirm('¿Confirmar pago en efectivo?');">
                                                            <i class="bi bi-check-circle"></i> Cobrar
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary disabled">
                                                        <i class="bi bi-receipt"></i> Recibo
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No hay cuotas registradas para este socie.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-book"></i> Historial de Préstamos</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Libro</th>
                                <th>Retirado</th>
                                <th>Vencimiento</th>
                                <th>Devolución</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Prestamos != null && Model.Prestamos.Any())
                            {
                                foreach (var prestamo in Model.Prestamos)
                                {
                                    <tr>
                                        <td>
                                            <strong>@prestamo.Libro.Titulo</strong>
                                            <br><small class="text-muted">Inv: @prestamo.Libro.CodigoInventario</small>
                                        </td>
                                        <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                        <td>@prestamo.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                        <td>@(prestamo.FechaDevolucion.HasValue ? prestamo.FechaDevolucion.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td>
                                            @if (prestamo.Estado == "Devuelto")
                                            {
                                                <span class="badge bg-success">Devuelto</span>
                                            }
                                            else if (prestamo.FechaVencimiento < DateTime.Now)
                                            {
                                                <span class="badge bg-danger">Vencido</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Activo</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No hay préstamos registrados para este socie.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                            
                </div>
            </div> <!-- Acá termina el div del card-body donde está tu tabla actual -->
            <!-- NUEVO BLOQUE: PAGINACIÓN DE PRÉSTAMOS -->
            @if (Model.TotalPaginasPrestamos > 1)
            {
                <div class="card-footer bg-light d-flex justify-content-center py-2 border-top-0">
                    <nav aria-label="Paginación de historial">
                        <ul class="pagination pagination-sm mb-0 shadow-sm">

                            <!-- Botón Anterior -->
                            <li class="page-item @(Model.PaginaActualPrestamos == 1 ? "disabled" : "")">
                                <a class="page-link" asp-route-id="@Model.Socio.Id" asp-route-paginaPrestamos="@(Model.PaginaActualPrestamos - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            <!-- Números de Página -->
                            @for (int i = 1; i <= Model.TotalPaginasPrestamos; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActualPrestamos ? "active" : "")">
                                    <a class="page-link" asp-route-id="@Model.Socio.Id" asp-route-paginaPrestamos="@i">@i</a>
                                </li>
                            }

                            <!-- Botón Siguiente -->
                            <li class="page-item @(Model.PaginaActualPrestamos == Model.TotalPaginasPrestamos ? "disabled" : "")">
                                <a class="page-link" asp-route-id="@Model.Socio.Id" asp-route-paginaPrestamos="@(Model.PaginaActualPrestamos + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                        </ul>
                    </nav>
                </div>
            }
        </div> <!-- Acá termina el card principal del historial -->
            </div>

            <!-- Botones actualizados y alineados a la derecha -->
            <div class="card-footer bg-white border-0 text-end p-4 border-top mt-2">
                <a asp-page="./Editar" asp-route-id="@Model.Socio.Id" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Editar Ficha</a>
                <a asp-page="./Inicio" class="btn btn-outline-secondary ms-2"><i class="bi bi-arrow-left"></i> Volver al Padrón</a>
            </div>
        </div>
    </div>
</div>