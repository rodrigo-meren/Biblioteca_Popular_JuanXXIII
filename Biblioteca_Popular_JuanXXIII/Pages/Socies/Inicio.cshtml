        <form method="get" class="mb-4">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Buscar Socie:</label>
                </div>
                <div class="col-md-5">
                    <!-- asp-for="Buscar" conecta este input con tu variable en C# -->
                    <input type="text" class="form-control shadow-sm" asp-for="Buscar" placeholder="DNI, Nombre o Apellido..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary shadow-sm"><i class="bi bi-search"></i> Buscar</button>
                    <a asp-page="./Inicio" class="btn btn-outline-secondary shadow-sm">Limpiar</a>
                </div>
            </div>
        </form>
        <table class="table table-hover table-striped align-middle mb-0">
           
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">DNI / Carnet</th>
                    <th>Socie</th>
                    <th>Categoría</th>
                    <th>Estado Cuota</th> <!-- Columna Nueva -->
                    <th>Activo</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Socio)
                {

                    // LÓGICA DEL SEMÁFORO DEL EXCEL PARA LA CUOTA
                    string claseColorCuota = "bg-secondary";
                    string textoCuota = "Sin registrar";
                    string fechaTexto = "";

                    if (item.FechaVencimiento.HasValue)
                    {
                        // Calculamos cuántos días pasaron desde el vencimiento hasta hoy
                        var diasVencidos = (DateTime.Today - item.FechaVencimiento.Value.Date).TotalDays;
                        fechaTexto = item.FechaVencimiento.Value.ToString("dd/MM/yy");

                        if (diasVencidos <= 0)
                        {
                            // No venció o vence hoy (Verde)
                            claseColorCuota = "bg-success";
                            textoCuota = "Al día";
                        }
                        else if (diasVencidos <= 10)
                        {
                            // Venció hace 10 días o menos (Amarillo)
                            claseColorCuota = "bg-warning text-dark";
                            textoCuota = "Alerta";
                        }
                        else
                        {
                            // Pasaron más de 10 días (Rojo)
                            claseColorCuota = "bg-danger";
                            textoCuota = "Deuda";
                        }
                    }

                    <tr>
                        <td class="ps-4 fw-bold text-secondary">@item.DniCarnet</td>
                        <td>
                            <span class="fw-bold">@item.Apellido, @item.Nombre</span>
                            @if (!string.IsNullOrEmpty(item.Pronombre))
                            {
                                <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.75rem;">@item.Pronombre</span>
                            }
                        </td>
                        <td>
                            <span class="badge border border-info text-info fs-7">@item.Categoria</span>
                        </td>

                        <!-- LA COLUMNA DE LA CUOTA CON EL SEMÁFORO -->
                        <td>
                            <span class="badge @claseColorCuota shadow-sm" title="Vencimiento: @fechaTexto">
                                @textoCuota
                            </span>
                            @if (item.FechaVencimiento.HasValue)
                            {
                                <small class="d-block text-muted" style="font-size: 0.70rem;">Vence: @fechaTexto</small>
                            }
                        </td>

                        <td>
                            @if (item.Activo)
                            {
                                <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Sí</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>No</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-page="./Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Ver detalles">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Editar" asp-route-id="@item.Id" class="btn btn-sm btn-secondary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger shadow-sm" onclick="return confirm('¿Estás seguro de que querés borrar a este socie?');">
                                    <i class="bi bi-x-circle"></i> Borrar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
       @if (Model.TotalPaginas > 1)
{
    // Calculamos el rango de páginas a mostrar (ventana de 5 páginas como máximo)
    int maxPaginasVisibles = 5;
    int paginaInicio = Math.Max(1, Model.PaginaActual - 2);
    int paginaFin = Math.Min(Model.TotalPaginas, paginaInicio + maxPaginasVisibles - 1);

    // Ajuste matemático por si el usuario está en las últimas páginas de la lista
    paginaInicio = Math.Max(1, paginaFin - maxPaginasVisibles + 1);

    <nav aria-label="Navegación de páginas">
        <ul class="pagination justify-content-center mt-4 shadow-sm">
            
            <!-- Botón Primera (Súper útil para volver rápido) -->
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="1" asp-route-Buscar="@Model.Buscar">
                    <i class="bi bi-chevron-double-left"></i> Primera
                </a>
            </li>

            <!-- Botón Anterior -->
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="@(Model.PaginaActual - 1)" asp-route-Buscar="@Model.Buscar">
                    <i class="bi bi-chevron-left"></i> Anterior
                </a>
            </li>

            <!-- Números de página con ventana dinámica -->
            @for (int i = paginaInicio; i <= paginaFin; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-route-PaginaActual="@i" asp-route-Buscar="@Model.Buscar">@i</a>
                </li>
            }

            <!-- Botón Siguiente -->
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="@(Model.PaginaActual + 1)" asp-route-Buscar="@Model.Buscar">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </a>
            </li>
            
            <!-- Botón Última -->
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-route-PaginaActual="@Model.TotalPaginas" asp-route-Buscar="@Model.Buscar">
                    Última <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
            
        </ul>
    </nav>
    
    <!-- Muestra informativa opcional para no perderse -->
    <div class="text-center text-muted small mt-2">
        Página @Model.PaginaActual de @Model.TotalPaginas
    </div>
}
    </div>
</div>