@page "/Socies"
@model Biblioteca_Popular_JuanXXIII.Pages.Socies.InicioModel
@{
    ViewData["Title"] = "Padrón de Socios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-institucional-rojo"><i class="bi bi-people-fill me-2"></i>Padrón de Socios</h1>
    <a asp-page="Alta" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Alta Socio
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0 table-responsive">

        <form method="get" class="mb-4 pt-3 px-3">
            <div class="row g-2 align-items-center">

                <div class="col-md-5">
                    <label class="col-form-label fw-bold text-muted small mb-1">Buscar Socio:</label>
                    <input type="text" class="form-control shadow-sm" asp-for="Buscar" placeholder="DNI, Nombre o Apellido..." />
                </div>

                <!-- NUEVO MENÚ DESPLEGABLE DE FILTRO -->
                <div class="col-md-3">
                    <label class="col-form-label fw-bold text-muted small mb-1">Estado:</label>
                    <select name="FiltroEstado" class="form-select shadow-sm" onchange="this.form.submit()">
                        <option value="Activos" selected="@(Model.FiltroEstado == "Activos")">Solo Activos</option>
                        <option value="Inactivos" selected="@(Model.FiltroEstado == "Inactivos")">Dados de Baja</option>
                        <option value="Todos" selected="@(Model.FiltroEstado == "Todos")">Mostrar Todos</option>
                    </select>
                </div>

                <div class="col-md-4 align-self-end">
                    <button type="submit" class="btn btn-primary shadow-sm"><i class="bi bi-search"></i> Filtrar</button>
                    <a asp-page="./Inicio" class="btn btn-outline-secondary shadow-sm">Limpiar</a>
                </div>
            </div>
        </form>

        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">DNI / Carnet</th>
                    <th>Socie</th>
                    <th>Categoría</th>
                    <th>Estado Cuota</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Socio)
                {
                    string claseColorCuota = "bg-secondary";
                    string textoCuota = "Sin registrar";
                    string fechaTexto = "";

                    if (item.FechaVencimiento.HasValue)
                    {
                        var diasVencidos = (DateTime.Today - item.FechaVencimiento.Value.Date).TotalDays;
                        fechaTexto = item.FechaVencimiento.Value.ToString("dd/MM/yy");

                        if (diasVencidos <= 0)
                        {
                            claseColorCuota = "bg-success";
                            textoCuota = "Al día";
                        }
                        else if (diasVencidos <= 10)
                        {
                            claseColorCuota = "bg-warning text-dark";
                            textoCuota = "Alerta";
                        }
                        else
                        {
                            claseColorCuota = "bg-danger";
                            textoCuota = "Deuda";
                        }
                    }

                    <tr>
                        <td class="ps-4 fw-bold text-secondary">@item.DniCarnet</td>
                        <td>
                            <span class="fw-bold">@item.Apellido, @item.Nombre</span>
                            @if (!string.IsNullOrEmpty(item.Pronombre))
                            {
                                <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.75rem;">@item.Pronombre</span>
                            }
                        </td>
                        <td>
                            <span class="badge border border-info text-info fs-7">@item.Categoria</span>
                        </td>
                        <td>
                            <span class="badge @claseColorCuota shadow-sm" title="Vencimiento: @fechaTexto">
                                @textoCuota
                            </span>
                            @if (item.FechaVencimiento.HasValue)
                            {
                                <small class="d-block text-muted" style="font-size: 0.70rem;">Vence: @fechaTexto</small>
                            }
                        </td>
                        <td class="text-end pe-4">
                            @if (item.Activo)
                            {
                                <!-- BOTÓN WHATSAPP (Solo si tiene teléfono) -->
                                @if (!string.IsNullOrEmpty(item.Telefono))
                                {
                                    // Limpiamos espacios y guiones para la API de WhatsApp
                                    string celLimpio = item.Telefono.Replace(" ", "").Replace("-", "").Replace("+", "");
                                    if (!celLimpio.StartsWith("54"))
                                    {
                                        celLimpio = "549" + celLimpio;
                                    }

                                    <a href="https://wa.me/@celLimpio" target="_blank" class="btn btn-sm btn-success text-white shadow-sm me-1" title="WhatsApp al @item.Telefono">
                                        <i class="bi bi-whatsapp"></i>
                                    </a>
                                }

                                <a asp-page="./Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white shadow-sm" title="Ver detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Editar" asp-route-id="@item.Id" class="btn btn-sm btn-secondary shadow-sm" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger shadow-sm" onclick="return confirm('¿Estás seguro de que querés borrar/dar de baja a este socie?');" title="Dar de baja">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-danger me-2">DADO DE BAJA</span>
                                <form method="post" asp-page-handler="Reactivar" asp-route-id="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success shadow-sm" title="Volver a dar de alta al padrón">
                                        <i class="bi bi-arrow-counterclockwise"></i> Reactivar
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- PAGINACIÓN CON MEMORIA DE FILTROS -->
        @if (Model.TotalPaginas > 1)
        {
            int maxPaginasVisibles = 5;
            int paginaInicio = Math.Max(1, Model.PaginaActual - 2);
            int paginaFin = Math.Min(Model.TotalPaginas, paginaInicio + maxPaginasVisibles - 1);

            paginaInicio = Math.Max(1, paginaFin - maxPaginasVisibles + 1);

            <nav aria-label="Navegación de páginas">
                <ul class="pagination justify-content-center mt-4 shadow-sm">

                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-PaginaActual="1" asp-route-Buscar="@Model.Buscar" asp-route-FiltroEstado="@Model.FiltroEstado">
                            <i class="bi bi-chevron-double-left"></i> Primera
                        </a>
                    </li>

                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-PaginaActual="@(Model.PaginaActual - 1)" asp-route-Buscar="@Model.Buscar" asp-route-FiltroEstado="@Model.FiltroEstado">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>

                    @for (int i = paginaInicio; i <= paginaFin; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-route-PaginaActual="@i" asp-route-Buscar="@Model.Buscar" asp-route-FiltroEstado="@Model.FiltroEstado">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-route-PaginaActual="@(Model.PaginaActual + 1)" asp-route-Buscar="@Model.Buscar" asp-route-FiltroEstado="@Model.FiltroEstado">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>

                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-route-PaginaActual="@Model.TotalPaginas" asp-route-Buscar="@Model.Buscar" asp-route-FiltroEstado="@Model.FiltroEstado">
                            Última <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>

            <div class="text-center text-muted small mt-2 pb-3">
                Página @Model.PaginaActual de @Model.TotalPaginas
            </div>
        }
    </div>
</div>