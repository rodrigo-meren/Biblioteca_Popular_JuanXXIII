    ViewData["Title"] = "Padrón de Socios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-institucional-rojo"><i class="bi bi-people-fill me-2"></i>Padrón de Socies</h1>
    <a asp-page="Alta" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Alta Socie
    </a>
  
</div>

