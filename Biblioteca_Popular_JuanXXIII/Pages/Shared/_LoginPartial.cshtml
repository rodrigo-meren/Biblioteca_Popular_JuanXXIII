@using Microsoft.AspNetCore.Identity
@using Biblioteca_Popular_JuanXXIII.Data
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext DbContext

@{
    // Por defecto, preparamos el DNI (o el correo, en el caso del primer admin)
    string nombreAMostrar = User.Identity?.Name ?? "";

    if (SignInManager.IsSignedIn(User) && !string.IsNullOrEmpty(nombreAMostrar))
    {
        // Vamos a la tabla Socios a buscar a la persona que tenga este DNI
        // Usamos .ToString() por si tu DniCarnet está guardado como número (int) en la tabla
        var socioLigado = DbContext.Socios.FirstOrDefault(s => s.DniCarnet.ToString() == nombreAMostrar);

        if (socioLigado != null)
        {
            // Si lo encuentra, sobrescribimos el DNI con el nombre real
            nombreAMostrar = $"{socioLigado.Nombre} {socioLigado.Apellido}";
        }
        else if (nombreAMostrar.Contains("@"))
        {
            // Un pequeño truco para que el administrador que creaste con correo se vea bien
            nombreAMostrar = "Administrador";
        }
    }
}

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item d-flex align-items-center">
            <span class="text-light me-3 fw-bold">
                <i class="bi bi-person-circle me-1"></i> Hola, @nombreAMostrar!
            </span>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn btn-outline-light btn-sm mt-1 shadow-sm">
                    <i class="bi bi-box-arrow-right"></i> Salir
                </button>
            </form>
        </li>
    }
    else
    {
       
        <li class="nav-item">
            <a class="btn btn-light btn-sm mt-1 ms-2 fw-bold text-institucional-rojo shadow-sm" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
            </a>
        </li>
    }
</ul>