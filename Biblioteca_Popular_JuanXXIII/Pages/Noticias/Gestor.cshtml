@page
@model Biblioteca_Popular_JuanXXIII.Pages.Noticias.GestorModel
@{
    ViewData["Title"] = "Gestor de Noticias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary fw-bold"><i class="bi bi-megaphone"></i> Gestor de Noticias</h1>
    <a asp-page="/Panel" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al Panel</a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- COLUMNA IZQUIERDA: Formulario para publicar -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-top border-primary border-4">
            <div class="card-header bg-white pb-2 pt-3">
                <h5 class="fw-bold text-dark mb-0">Publicar Anuncio</h5>
            </div>
            <div class="card-body bg-light">
                <form method="post" asp-page-handler="Crear">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small">Título del Anuncio</label>
                        <input asp-for="NuevaNoticia.Titulo" class="form-control" placeholder="Ej: ¡Nuevo taller de lectura!" required autocomplete="off" />
                        <span asp-validation-for="NuevaNoticia.Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small">Contenido</label>
                        <textarea asp-for="NuevaNoticia.Contenido" class="form-control" rows="5" placeholder="Escribí los detalles acá..." required></textarea>
                        <span asp-validation-for="NuevaNoticia.Contenido" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Publicar en Portada
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- COLUMNA DERECHA: Historial de Noticias -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Título</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListaNoticias != null && Model.ListaNoticias.Any())
                            {
                                foreach (var noticia in Model.ListaNoticias)
                                {
                                    <tr class="@(!noticia.Activa ? "table-secondary text-muted" : "")">
                                        <td>@noticia.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold">@noticia.Titulo</td>
                                        <td>
                                            @if (noticia.Activa)
                                            {
                                                <span class="badge bg-success">Visible en Portada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Oculta</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <!-- Botón para Mostrar/Ocultar -->
                                                <form method="post" asp-page-handler="AlternarEstado" class="m-0">
                                                    <input type="hidden" name="id" value="@noticia.Id" />
                                                    <button type="submit" class="btn btn-sm @(noticia.Activa ? "btn-outline-warning" : "btn-outline-success")" title="Alternar visibilidad">
                                                        @if (noticia.Activa)
                                                        {
                                                            <i class="bi bi-eye-slash"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-eye"></i>
                                                        }
                                                    </button>
                                                </form>

                                                <!-- Botón para Eliminar definitivo -->
                                                <form method="post" asp-page-handler="Eliminar" class="m-0" onsubmit="return confirm('¿Estás seguro de que querés borrar esta noticia para siempre?');">
                                                    <input type="hidden" name="id" value="@noticia.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-journal-text fs-2 d-block mb-2 opacity-25"></i>
                                        No hay noticias publicadas.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>