@page
@model Biblioteca_Popular_JuanXXIII.Pages.Libros.AltaModel
@{
    ViewData["Title"] = "Nuevo Libro";
}

<h2>Dar de alta un nuevo libro</h2>
@if (TempData["CodigoGenerado"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow border-2 border-success" role="alert">
        <h4 class="alert-heading mb-2"><i class="bi bi-check-circle-fill me-2"></i>¡Libro guardado con éxito!</h4>
        <p class="mb-2">El libro se registró correctamente en el catálogo.</p>
        <hr>
        <p class="mb-0 fs-5">
            Por favor, asignale la etiqueta con el inventario número: 
            <strong class="bg-white text-success px-2 py-1 rounded border border-success fs-4">@TempData["CodigoGenerado"]</strong>
        </p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<hr />
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 border-top border-primary border-4 mb-5">
    <div class="card-header bg-white pb-2 pt-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-journal-arrow-up text-primary me-2"></i> Importación Masiva de Libros (CSV)
        </h5>
    </div>
    <div class="card-body bg-light">
        <form method="post" enctype="multipart/form-data" asp-page-handler="Importar">
            <div class="row align-items-end g-3">
                <div class="col-md-9">
                    <label for="archivoCsv" class="form-label fw-bold text-secondary small mb-1">
                        Seleccioná el catálogo de libros (.csv separado por punto y coma)
                    </label>
                    <input class="form-control bg-white shadow-sm" type="file" id="archivoCsv" name="archivoCsv" accept=".csv" required>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary text-white fw-bold shadow-sm w-100">
                        <i class="bi bi-cloud-upload me-1"></i> Importar Libros
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<hr class="mb-4" />
<form method="post" class="mt-4">
    <div class="row">
        <!-- Columna Izquierda -->
        <div class="col-md-6 pe-md-4 border-end">

            <div class="form-group mb-3">
                <label asp-for="Libro.ISBN" class="control-label fw-bold">ISBN</label>
                <div class="input-group">
                    <input asp-for="Libro.ISBN" id="inputIsbn" class="form-control" placeholder="Opcional. Ej: 9789875666472" />
                    <button type="button" id="btnBuscarIsbn" class="btn btn-outline-info">Autocompletar</button>
                </div>
            </div>

            <!-- CÓDIGO DE INVENTARIO AUTOMÁTICO (Solo lectura) -->
            <div class="form-group mb-3">
                 <label asp-for="Libro.CodigoInventario" class="control-label fw-bold text-primary">
                     <i class="bi bi-tag-fill me-1"></i>N° de Etiqueta (Inventario)
                 </label>
                 <!-- Muestra en vivo el número calculado por el backend -->
                 <input asp-for="Libro.CodigoInventario" class="form-control bg-light text-primary fw-bold fs-5 border-primary" readonly />
                 <span asp-validation-for="Libro.CodigoInventario" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Libro.Titulo" class="control-label fw-bold">Título *</label>
                <input asp-for="Libro.Titulo" id="inputTitulo" class="form-control" required />
                <span asp-validation-for="Libro.Titulo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Libro.Autor" class="control-label fw-bold">Autor</label>
                <input asp-for="Libro.Autor" id="inputAutor" class="form-control" data-val="false" />
                <span asp-validation-for="Libro.Autor" class="text-danger"></span>
            </div>

            <!-- Contenedor para previsualizar la portada -->
            <div class="mb-4 text-center">
                <img id="imgPortadaPreview" src="" alt="Previsualización de portada" class="img-fluid rounded shadow" style="max-height: 250px; display: none;" />
            </div>
        </div>

        <!-- Columna Derecha -->
        <div class="col-md-6 ps-md-4">

            <div class="form-group mb-3">
                <label asp-for="Libro.Editorial" class="control-label fw-bold">Editorial</label>
                <input asp-for="Libro.Editorial" id="inputEditorial" class="form-control" />
            </div>

            <div class="row">
                <div class="col-6 form-group mb-3">
                    <label asp-for="Libro.AnioPublicacion" class="control-label fw-bold">Año</label>
                    <input asp-for="Libro.AnioPublicacion" id="inputAnio" class="form-control" />
                </div>
                <div class="col-6 form-group mb-3">
    <label asp-for="Libro.GeneroLiterario" class="control-label fw-bold">Género / CDD</label>
    <input asp-for="Libro.GeneroLiterario" id="inputGenero" class="form-control" list="listaGeneros" autocomplete="off" />
    
    <!-- Lista de ayuda visual para el bibliotecario -->
    <datalist id="listaGeneros">
       
        <option value="Ajedrez"></option>
        <option value="Antropologia"></option>
        <option value="Arte. Dibujo. Pintura"></option>
        <option value="Autores locales"></option>
        <option value="Bibliotecologia"></option>
        <option value="Cine"></option>
        <option value="Divulgacion cientifica"></option>
        <option value="Fotografia"></option>
        <option value="Musica. Teoria musical. Danza"></option>
        <option value="Reproduccion. Maternidad"></option>
        <option value="Sociologia"></option>
        <option value="Trabajo social"></option>       
        <option value="Ciencia Ficción"></option>
        <option value="Cuento / Relato"></option>
        <option value="Ensayo"></option>
        <option value="Literatura / Lingüística"></option>
        <option value="Literatura Infantil / Juvenil"></option>
        <option value="Mitos y Leyendas"></option>
        <option value="Narrativa"></option>
        <option value="Novela"></option>
        <option value="Novela Corta"></option>
        <option value="Novela Histórica"></option>
        <option value="Poesía"></option>
        <option value="Teatro / Drama"></option>
        <option value="Arte / Deportes / Recreación"></option>
        <option value="Biografías"></option>
        <option value="Ciencias Aplicadas / Tecnología / Medicina"></option>
        <option value="Ciencias Exactas y Naturales"></option>
        <option value="Ciencias Sociales (Derecho, Educación)"></option>
        <option value="Filosofía"></option>
        <option value="General"></option>
        <option value="Historia / Geografía"></option>
        <option value="Historia Argentina"></option>
        <option value="Obras Generales / Referencia"></option>
        <option value="Psicología"></option>
        <option value="Religión / Teología"></option>
    </datalist>
</div>
            </div>

            <!-- UBICACIÓN FÍSICA -->
            <div class="form-group mb-3 bg-light p-3 rounded border">
                <label asp-for="Libro.UbicacionFisica" class="control-label fw-bold text-dark">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> Ubicación Física en Biblioteca
                </label>
                <input asp-for="Libro.UbicacionFisica" class="form-control border-secondary mt-1" placeholder="Ej: Estante 3, Sector Historia" />
                <span asp-validation-for="Libro.UbicacionFisica" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Libro.Sinopsis" class="control-label fw-bold">Sinopsis</label>
                <textarea asp-for="Libro.Sinopsis" id="inputSinopsis" class="form-control" rows="4"></textarea>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-3 border-top text-end">
        <a asp-page="Index" class="btn btn-outline-secondary me-2">Volver a la lista</a>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-2"></i>Guardar Libro</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ==========================================
        // 1. LÓGICA DEL BUSCADOR DE ISBN
        // ==========================================
        document.getElementById('btnBuscarIsbn').addEventListener('click', async function() {
            const isbn = document.getElementById('inputIsbn').value.trim();

            if (!isbn) {
                alert('Ingresá un ISBN primero');
                return;
            }

            const btn = this;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Buscando...';
            btn.disabled = true;

            try {
                const response = await fetch(`https://openlibrary.org/api/books?bibkeys=ISBN:${isbn}&format=json&jscmd=data`);
                const data = await response.json();
                const bookKey = `ISBN:${isbn}`;

                if (data[bookKey]) {
                    const libro = data[bookKey];
                    document.getElementById('inputTitulo').value = libro.title || '';
                    document.getElementById('inputAutor').value = libro.authors ? libro.authors.map(a => a.name).join(', ') : '';
                    document.getElementById('inputEditorial').value = libro.publishers ? libro.publishers.map(p => p.name).join(', ') : '';

                    if (libro.publish_date) {
                        const yearMatch = libro.publish_date.match(/\d{4}/);
                        document.getElementById('inputAnio').value = yearMatch ? yearMatch[0] : '';
                    } else {
                        document.getElementById('inputAnio').value = '';
                    }

                    if (libro.subjects && libro.subjects.length > 0) {
                        document.getElementById('inputGenero').value = libro.subjects.slice(0, 3).map(s => s.name).join(', ');
                    } else {
                        document.getElementById('inputGenero').value = '';
                    }

                    document.getElementById('inputSinopsis').value = libro.notes || '';

                    const imgPreview = document.getElementById('imgPortadaPreview');
                    if (libro.cover) {
                        let coverUrl = libro.cover.large || libro.cover.medium;
                        if (coverUrl) {
                            imgPreview.src = coverUrl;
                            imgPreview.style.display = 'inline-block';
                        }
                    } else {
                        imgPreview.style.display = 'none';
                        imgPreview.src = '';
                    }
                } else {
                    alert('No se encontró información para este ISBN en Open Library.');
                }
            } catch (error) {
                console.error(error);
                alert('Error de conexión con la API de Open Library.');
            } finally {
                btn.innerHTML = 'Autocompletar';
                btn.disabled = false;
            }
        }); // <--- ESTA LLAVE ERA LA QUE FALTABA

        // ==========================================
        // 2. LÓGICA DEL GÉNERO AUTOMÁTICO (CDD)
        // ==========================================
        const inputUbicacion = document.querySelector('[name="Libro.UbicacionFisica"]');
        const inputGenero = document.getElementById('inputGenero');

        if (inputUbicacion && inputGenero) {
            inputUbicacion.addEventListener('blur', async function() {
                const valorUbicacion = this.value.trim();
                
                if (valorUbicacion) {
                    try {
                        const response = await fetch(`?handler=ObtenerGenero&ubicacion=${encodeURIComponent(valorUbicacion)}`);
                        const generoSugerido = await response.json();

                        if (!inputGenero.value || inputGenero.value === "Sin clasificar" || inputGenero.value === "General") {
                            inputGenero.value = generoSugerido;
                        }
                    } catch (error) {
                        console.error("Error al obtener el género:", error);
                    }
                }
            });
        }
    </script>
}
