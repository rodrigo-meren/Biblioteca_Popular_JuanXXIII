@page
@model Biblioteca_Popular_JuanXXIII.Pages.Libros.AltaModel
@{
    ViewData["Title"] = "Nuevo Libro";
}

<h2>Dar de alta un nuevo libro</h2>
<hr />
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 border-top border-primary border-4 mb-5">
    <div class="card-header bg-white pb-2 pt-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-journal-arrow-up text-primary me-2"></i> Importación Masiva de Libros (CSV)
        </h5>
    </div>
    <div class="card-body bg-light">
        <form method="post" enctype="multipart/form-data" asp-page-handler="Importar">
            <div class="row align-items-end g-3">
                <div class="col-md-9">
                    <label for="archivoCsv" class="form-label fw-bold text-secondary small mb-1">
                        Seleccioná el catálogo de libros (.csv separado por punto y coma)
                    </label>
                    <input class="form-control bg-white shadow-sm" type="file" id="archivoCsv" name="archivoCsv" accept=".csv" required>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary text-white fw-bold shadow-sm w-100">
                        <i class="bi bi-cloud-upload me-1"></i> Importar Libros
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<hr class="mb-4" />
<form method="post">
    <div class="row">
        <!-- Columna Izquierda -->
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Libro.ISBN" class="control-label fw-bold">ISBN</label>
                <div class="input-group">
                    <input asp-for="Libro.ISBN" id="inputIsbn" class="form-control" placeholder="Opcional. Ej: 9789875666472" />
                    <button type="button" id="btnBuscarIsbn" class="btn btn-outline-info">Autocompletar</button>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Libro.CodigoInventario" class="control-label fw-bold">Código de Inventario *</label>
                <input asp-for="Libro.CodigoInventario" class="form-control" />
                <span asp-validation-for="Libro.CodigoInventario" class="text-danger"></span>
            </div>
            <!-- Contenedor para previsualizar la portada -->
            <div class="mb-4 text-center">
                <img id="imgPortadaPreview" src="" alt="Previsualización de portada" class="img-fluid rounded shadow" style="max-height: 250px; display: none;" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Libro.Titulo" class="control-label fw-bold">Título *</label>
                <input asp-for="Libro.Titulo" id="inputTitulo" class="form-control" />
                <span asp-validation-for="Libro.Titulo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Libro.Autor" class="control-label fw-bold">Autor *</label>
                <input asp-for="Libro.Autor" id="inputAutor" class="form-control" />
                <span asp-validation-for="Libro.Autor" class="text-danger"></span>
            </div>
        </div>
        <!-- Este bloque solo se renderiza en el HTML si el usuario tiene el rol "Admin" -->
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <div class="form-group mb-3 bg-warning bg-opacity-10 p-2 rounded border border-warning">
                <label asp-for="Libro.UbicacionFisica" class="control-label fw-bold text-dark">
                    <i class="bi bi-geo-alt-fill text-danger"></i> Ubicación Física (Solo Admin)
                </label>
                <input asp-for="Libro.UbicacionFisica" class="form-control border-warning" placeholder="Ej: Estante 3, Sector Historia" />
            </div>
        }
    </div>
        <!-- En la columna derecha de tu Alta.cshtml -->
<div class="form-group mb-3">
    <label asp-for="Libro.Editorial" class="control-label fw-bold">Editorial</label>
    <input asp-for="Libro.Editorial" id="inputEditorial" class="form-control" />
</div>

<div class="row">
    <div class="col-6 form-group mb-3">
        <label asp-for="Libro.AnioPublicacion" class="control-label fw-bold">Año</label>
        <input asp-for="Libro.AnioPublicacion" id="inputAnio" class="form-control" />
    </div>
    <!-- Acá agregamos el campo nuevo de Género -->
    <div class="col-6 form-group mb-3">
        <label asp-for="Libro.GeneroLiterario" class="control-label fw-bold">Género</label>
        <input asp-for="Libro.GeneroLiterario" id="inputGenero" class="form-control" />
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="Libro.Sinopsis" class="control-label fw-bold">Sinopsis</label>
    <textarea asp-for="Libro.Sinopsis" id="inputSinopsis" class="form-control" rows="4"></textarea>
</div>


    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar Libro</button>
        <a asp-page="Index" class="btn btn-outline-secondary ms-2">Volver a la lista</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.getElementById('btnBuscarIsbn').addEventListener('click', async function () {
            const isbn = document.getElementById('inputIsbn').value.trim();
            
            if (!isbn) { 
                alert('Ingresá un ISBN primero'); 
                return; 
            }
            
            const btn = this; 
            // Le sumamos un mini ícono de carga para que quede más profesional
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Buscando...'; 
            btn.disabled = true;
            
            try {
                // Llamada a la API de Open Library
                const response = await fetch(`https://openlibrary.org/api/books?bibkeys=ISBN:${isbn}&format=json&jscmd=data`);
                const data = await response.json();
                
                const bookKey = `ISBN:${isbn}`;

                // Si el JSON de respuesta tiene el ISBN, es que lo encontró
                if (data[bookKey]) {
                    const libro = data[bookKey];

                    // Título
                    document.getElementById('inputTitulo').value = libro.title || '';
                    
                    // Autor (Open Library trae un array, así que los unimos con coma)
                    document.getElementById('inputAutor').value = libro.authors ? libro.authors.map(a => a.name).join(', ') : '';
                    
                    // Editorial
                    document.getElementById('inputEditorial').value = libro.publishers ? libro.publishers.map(p => p.name).join(', ') : '';
                    
                    // Año de publicación (A veces traen "Oct 12, 1997", extraemos solo los 4 dígitos)
                    if (libro.publish_date) {
                        const yearMatch = libro.publish_date.match(/\d{4}/);
                        document.getElementById('inputAnio').value = yearMatch ? yearMatch[0] : '';
                    } else {
                        document.getElementById('inputAnio').value = '';
                    }

                    // Género (Open Library usa 'subjects', agarramos los primeros 3 para no saturar el campo)
                    if (libro.subjects && libro.subjects.length > 0) {
                        document.getElementById('inputGenero').value = libro.subjects.slice(0, 3).map(s => s.name).join(', ');
                    } else {
                        document.getElementById('inputGenero').value = '';
                    }

                    // Sinopsis / Notas (Open Library suele ser más flojo en sinopsis, pero probamos sacar las notas)
                    document.getElementById('inputSinopsis').value = libro.notes || '';

                    // LÓGICA DE LA PORTADA
                    const imgPreview = document.getElementById('imgPortadaPreview');

                    if (libro.cover) {
                        // Priorizamos la portada grande, si no hay, la mediana
                        let coverUrl = libro.cover.large || libro.cover.medium;
                        if (coverUrl) {
                            imgPreview.src = coverUrl;
                            imgPreview.style.display = 'inline-block';
                        }
                    } else {
                        imgPreview.style.display = 'none';
                        imgPreview.src = '';
                    }

                } else {
                    alert('No se encontró información para este ISBN en Open Library.');
                }
            } catch (error) {
                console.error(error);
                alert('Error de conexión con la API de Open Library.');
            } finally {
                // Restauramos el botón
                btn.innerHTML = 'Autocompletar'; 
                btn.disabled = false; 
            }
        });
    </script>
}
