@page "/Libros"
@model Biblioteca_Popular_JuanXXIII.Pages.Libros.InicioModel
@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-danger">Catálogo de Libros</h1> 
    <a asp-page="./Alta" class="btn btn-primary">Nuevo Libro</a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Inventario</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Disponibilidad</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Libro)
            {
                <tr>
                    <td><strong>@item.CodigoInventario</strong></td>
                    <td>@item.Titulo</td>
                    <td>@item.Autor</td>
                    <td>
                        @if (item.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Prestado</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="./Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                        <!-- Botón Eliminar con cartel de advertencia integrado -->
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('¿Estás seguro de que querés borrar este libro? Esta acción no se puede deshacer.');">
                                Borrar
                            </button>
                        </form>
                        <a asp-page="./Editar" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Editar</a>
                        
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>