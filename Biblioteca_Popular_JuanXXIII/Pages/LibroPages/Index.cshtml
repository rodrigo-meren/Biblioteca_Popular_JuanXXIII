@page
@model Biblioteca_Popular_JuanXXIII.Pages.LibroPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].CodigoInventario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].Autor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].Editorial)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].AnioPublicacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].ISBN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].SignaturaDewey)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].TipoMaterial)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].Sinopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro[0].Disponible)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Libro) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CodigoInventario)
            </td>
            <td>
                @Html.DisplayFor(model => item.Titulo)
            </td>
            <td>
                @Html.DisplayFor(model => item.Autor)
            </td>
            <td>
                @Html.DisplayFor(model => item.Editorial)
            </td>
            <td>
                @Html.DisplayFor(model => item.AnioPublicacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.ISBN)
            </td>
            <td>
                @Html.DisplayFor(model => item.SignaturaDewey)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipoMaterial)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sinopsis)
            </td>
            <td>
                @Html.DisplayFor(model => item.Disponible)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
