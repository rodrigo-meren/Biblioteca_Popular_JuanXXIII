@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-danger text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2"></i>Acceso al Sistema</h4>
            </div>
            <div class="card-body p-4">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Dni" class="form-control" autocomplete="username" aria-required="true" placeholder="DNI" />
                        <!-- Cambiamos la etiqueta visual para que diga DNI -->
                        <label asp-for="Input.Dni" class="form-label">DNI</label>
                        <span asp-validation-for="Input.Dni" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Contraseña" />
                        <label asp-for="Input.Password" class="form-label">Contraseña</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label text-muted" asp-for="Input.RememberMe">
                            Recordar mis datos
                        </label>
                    </div>
                    
                    <button id="login-submit" type="submit" class="btn btn-danger w-100 fw-bold py-2 shadow-sm">
                        Ingresar <i class="bi bi-box-arrow-in-right ms-1"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>